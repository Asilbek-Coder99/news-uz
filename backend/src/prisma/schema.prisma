// NEWS.UZ — Prisma Database Schema
// Premium Uzbek News Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  USER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── USER ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  fullName      String?
  passwordHash  String
  avatarUrl     String?
  bio           String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// ─── REFRESH TOKEN ───────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── CATEGORY ────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  nameUz      String
  slug        String  @unique
  description String?
  color       String  @default("#000000")
  icon        String?
  parentId    String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-relation for subcategories
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")

  // Relations
  articles Article[]

  @@map("categories")
}

// ─── TAG ─────────────────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles ArticleTag[]

  @@map("tags")
}

// ─── ARTICLE ─────────────────────────────────────────────

model Article {
  id            String        @id @default(cuid())
  title         String
  titleUz       String?
  slug          String        @unique
  excerpt       String?
  content       String        @db.Text
  coverImage    String?
  coverImageAlt String?
  status        ArticleStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  isBreaking    Boolean       @default(false)
  isTrending    Boolean       @default(false)
  viewCount     Int           @default(0)
  readTimeMin   Int           @default(3)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Foreign keys
  categoryId  String
  authorId    String
  authorName  String          // Cached for performance

  // Relations
  category  Category     @relation(fields: [categoryId], references: [id])
  tags      ArticleTag[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  images    ArticleImage[]

  @@index([slug])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([isTrending])
  @@map("articles")
}

// ─── ARTICLE TAG (join) ───────────────────────────────────

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

// ─── ARTICLE IMAGE ────────────────────────────────────────

model ArticleImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  caption   String?
  width     Int?
  height    Int?
  articleId String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_images")
}

// ─── COMMENT ─────────────────────────────────────────────

model Comment {
  id        String        @id @default(cuid())
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Foreign keys
  articleId String
  userId    String
  parentId  String?

  // Relations
  article  Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([articleId])
  @@map("comments")
}

// ─── LIKE ────────────────────────────────────────────────

model Like {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@map("likes")
}

// ─── BOOKMARK ────────────────────────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@map("bookmarks")
}
